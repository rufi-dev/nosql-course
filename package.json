{
  "name": "nosql-course",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,api,web -c gray,blue,magenta \"npm:dev:db\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:api": "node --watch-path=server --watch-path=src/lib --watch-path=src/data --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "oxlint src server",
    "test": "node --test tests/*.test.mjs",
    "preview": "npm run build && node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "motion": "^14.14.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^19.0.0-beta.20",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  },
  "description": "NoSQL, NewSQL and Distributed Architectures: interactive course platform (React + Express + PostgreSQL).",
  "engines": {
    "node": ">=22"
  }
}
